# Opcional: URL fija del API (sin barra final). Si está definida, anula la detección automática.
# En desarrollo suele mejor NO definirla: emulador → 10.0.2.2, Expo en móvil → IP del bundler.
# EXPO_PUBLIC_API_URL=https://api.ejemplo.com

# Opcional: puerto del API cuando la URL se infiere (por defecto 3000 o app.json extra.apiPort).
# EXPO_PUBLIC_API_PORT=3000
